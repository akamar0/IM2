# Copy this file to .env and change the values for your own computer.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL connection (SQLite is intentionally not configured)
DB_NAME=unifix_db
DB_USER=unifix_user
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=5432
